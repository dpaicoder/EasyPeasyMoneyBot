# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Admin Configuration
ADMIN_USER_ID=your_telegram_user_id

# Reward Configuration
REFERRAL_BONUS=10.0
MIN_WITHDRAWAL=5.0
TASK_REWARD=2.0

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///referral_bot.db

# Bot Settings
BOT_NAME=ReferEarnBot
BOT_USERNAME=your_bot_username
BOT_DESCRIPTION=A bot for earning rewards through referrals and tasks

# Notification Settings
NOTIFY_ADMIN=true
ADMIN_NOTIFICATION_CHAT_ID=your_admin_chat_id

# Security Settings
MAX_TASKS_PER_DAY=10
MAX_REFERRALS_PER_DAY=5 
